@{
    ViewData["Title"] = "Gestão Integrada";
    Layout = "_DashboardLayout";
}

<div class="dashboard-shell">
    <aside class="sidebar" aria-label="Navegação principal">
        <div class="brand-header">
            <div class="brand-logo-icon">
                <i class="fa-solid fa-heart-pulse"></i>
            </div>
            <div class="brand-text">
                <h1>Clínica Vitta</h1>
                <p>Gestão de consultas</p>
            </div>
        </div>

        <ul class="nav-menu" role="tablist">
            <li class="nav-item active" data-tab="dashboard">
                <button type="button" data-action="tab" data-tab-target="dashboard">
                    <i class="fa-solid fa-border-all"></i><span>Dashboard</span>
                </button>
            </li>
            <li class="nav-item" data-tab="agenda">
                <button type="button" data-action="tab" data-tab-target="agenda">
                    <i class="fa-solid fa-calendar-days"></i><span>Agenda</span>
                </button>
            </li>
            <li class="nav-item" data-tab="pacientes">
                <button type="button" data-action="tab" data-tab-target="pacientes">
                    <i class="fa-solid fa-user-group"></i><span>Pacientes</span>
                </button>
            </li>
            <li class="nav-item" data-tab="profissionais">
                <button type="button" data-action="tab" data-tab-target="profissionais">
                    <i class="fa-solid fa-user-doctor"></i><span>Profissionais</span>
                </button>
            </li>
            <li class="nav-item" data-tab="historico">
                <button type="button" data-action="tab" data-tab-target="historico">
                    <i class="fa-solid fa-clock-rotate-left"></i><span>Histórico</span>
                </button>
            </li>
        </ul>
    </aside>

    <div class="main-wrapper">
        <header class="top-header">
            <div class="user-welcome">
                <span class="category-tag" id="header-category-tag">VISÃO GERAL</span>
                <h2 class="header-title" id="header-main-title">Clínica Vitta</h2>
            </div>

            <div class="header-actions">
                <button type="button" class="btn-primary" data-action="new-appointment">
                    <i class="fa-solid fa-plus"></i> Novo agendamento
                </button>

                <form class="logout-form" asp-controller="Auth" asp-action="Logout" method="post">
                    <button class="logout-button" type="submit">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i><span>Sair</span>
                    </button>
                </form>
            </div>
        </header>

        <!-- DASHBOARD -->
        <main class="content-body tab-pane active" id="tab-dashboard">
            <section class="dashboard-hero-card">
                <div class="hero-top">
                    <div>
                        <span class="welcome-chip">
                            <i class="fa-solid fa-chart-simple"></i> Dados atuais
                        </span>
                        <h2>Visão geral da clínica.</h2>
                        <p>Os indicadores abaixo são calculados exclusivamente a partir dos cadastros e agendamentos retornados pela API.</p>
                    </div>
                    <div class="welcome-illustration" aria-hidden="true">
                        <i class="fa-solid fa-heart-pulse"></i>
                    </div>
                </div>

                <div class="hero-stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon teal"><i class="fa-solid fa-calendar-check"></i></div>
                        <div class="stat-info">
                            <span class="stat-label">Agendamentos</span>
                            <div class="stat-value" id="dash-total-schedules">0</div>
                            <span class="stat-sub">Registros retornados pela API</span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
                        <div class="stat-info">
                            <span class="stat-label">Pacientes ativos</span>
                            <div class="stat-value" id="dash-total-clients">0</div>
                            <span class="stat-sub">Cadastros ativos</span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon purple"><i class="fa-solid fa-user-doctor"></i></div>
                        <div class="stat-info">
                            <span class="stat-label">Profissionais ativos</span>
                            <div class="stat-value" id="dash-total-doctors">0</div>
                            <span class="stat-sub">Cadastros ativos</span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon green"><i class="fa-solid fa-circle-check"></i></div>
                        <div class="stat-info">
                            <span class="stat-label">Concluídos</span>
                            <div class="stat-value" id="dash-total-attended">0</div>
                            <span class="stat-sub">Agendamentos atendidos</span>
                        </div>
                    </div>
                </div>
            </section>

            <div class="dashboard-lower-grid">
                <article class="dashboard-card">
                    <div class="card-heading">
                        <div>
                            <span class="card-kicker">AGENDA</span>
                            <h2>Próximos agendamentos</h2>
                        </div>
                        <button type="button" class="visual-link" data-action="tab" data-tab-target="agenda">
                            Ver agenda <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                    <div class="appointment-preview-list" id="dashboard-preview-list">
                        <div class="empty-state">Carregando...</div>
                    </div>
                </article>

                <aside class="dashboard-card focus-card">
                    <span class="panel-subtitle">STATUS</span>
                    <h3 class="panel-title">Agendamentos</h3>

                    <div class="progress-box">
                        <div class="progress-meta">
                            <div class="count" id="dash-status-total">0</div>
                            <div class="desc">total de registros</div>
                        </div>
                    </div>

                    <div class="alert-info-box">
                        <i class="fa-solid fa-circle-info"></i>
                        <span id="dash-status-summary">Nenhum agendamento carregado.</span>
                    </div>
                </aside>
            </div>
        </main>

        <!-- AGENDA -->
        <main class="content-body tab-pane" id="tab-agenda">
            <div class="stats-banner">
                <div class="stat-card">
                    <div class="stat-icon teal"><i class="fa-solid fa-calendar-check"></i></div>
                    <div class="stat-info"><span class="stat-label">Total</span><div class="stat-value" id="agenda-total">0</div></div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon amber"><i class="fa-solid fa-clock"></i></div>
                    <div class="stat-info"><span class="stat-label">Pendentes</span><div class="stat-value" id="agenda-pending">0</div></div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon blue"><i class="fa-solid fa-stethoscope"></i></div>
                    <div class="stat-info"><span class="stat-label">Em atendimento</span><div class="stat-value" id="agenda-ongoing">0</div></div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon green"><i class="fa-solid fa-circle-check"></i></div>
                    <div class="stat-info"><span class="stat-label">Concluídos</span><div class="stat-value" id="agenda-attended">0</div></div>
                </div>
            </div>

            <div class="agenda-container">
                <div class="controls-row">
                    <div class="search-wrapper">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search" class="search-input" id="agenda-search" placeholder="Buscar paciente ou profissional">
                    </div>

                    <div class="filter-group">
                        <input type="date" class="date-input" id="agenda-date">
                        <select class="select-input" id="agenda-status">
                            <option value="">Todos os status</option>
                            <option value="PENDENTE">Pendente</option>
                            <option value="ATENDENDO">Em atendimento</option>
                            <option value="ATENDIDO">Concluído</option>
                            <option value="CANCELADO">Cancelado</option>
                        </select>
                    </div>
                </div>

                <div class="timeline-list" id="appointment-list">
                    <div class="empty-state">Carregando agendamentos...</div>
                </div>
            </div>
        </main>

        <!-- PACIENTES -->
        <main class="content-body tab-pane" id="tab-pacientes">
            <div class="stats-banner">
                <div class="stat-card">
                    <div class="stat-icon teal"><i class="fa-solid fa-users"></i></div>
                    <div class="stat-info"><span class="stat-label">Pacientes ativos</span><div class="stat-value" id="patients-total">0</div></div>
                </div>
            </div>

            <div class="table-container">
                <div class="controls-row">
                    <div class="search-wrapper">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search" class="search-input" id="patient-search" placeholder="Buscar paciente por nome ou e-mail">
                    </div>
                    <button type="button" class="btn-primary" data-action="new-patient">
                        <i class="fa-solid fa-user-plus"></i> Novo paciente
                    </button>
                </div>

                <table class="patient-table">
                    <thead>
                        <tr>
                            <th>Paciente</th>
                            <th>E-mail</th>
                            <th>Idade</th>
                            <th>Gênero</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="patient-table-body">
                        <tr><td colspan="6" class="empty-state">Carregando pacientes...</td></tr>
                    </tbody>
                </table>
            </div>
        </main>

        <!-- PROFISSIONAIS -->
        <main class="content-body tab-pane" id="tab-profissionais">
            <div class="stats-banner">
                <div class="stat-card">
                    <div class="stat-icon purple"><i class="fa-solid fa-user-doctor"></i></div>
                    <div class="stat-info"><span class="stat-label">Profissionais ativos</span><div class="stat-value" id="doctors-total">0</div></div>
                </div>
            </div>

            <div class="doctors-container">
                <div class="controls-row">
                    <div class="search-wrapper">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search" class="search-input" id="doctor-search" placeholder="Buscar profissional por nome ou e-mail">
                    </div>
                    <button type="button" class="btn-primary" data-action="new-doctor">
                        <i class="fa-solid fa-user-plus"></i> Novo profissional
                    </button>
                </div>

                <div class="doctors-grid" id="doctors-grid-container">
                    <div class="empty-state">Carregando profissionais...</div>
                </div>
            </div>
        </main>

        <!-- HISTÓRICO -->
        <main class="content-body tab-pane" id="tab-historico">
            <div class="stats-banner">
                <div class="stat-card">
                    <div class="stat-icon teal"><i class="fa-solid fa-clipboard-check"></i></div>
                    <div class="stat-info"><span class="stat-label">Concluídos</span><div class="stat-value" id="history-total">0</div><span class="stat-sub">Calculado pela API</span></div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon blue"><i class="fa-solid fa-calendar-xmark"></i></div>
                    <div class="stat-info"><span class="stat-label">Cancelados</span><div class="stat-value" id="history-cancelled">0</div></div>
                </div>
            </div>

            <div class="table-container">
                <div class="controls-row">
                    <div class="search-wrapper">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search" class="search-input" id="history-search" placeholder="Buscar paciente ou profissional">
                    </div>
                </div>

                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Data e hora</th>
                            <th>Paciente</th>
                            <th>Profissional</th>
                            <th>Especialidade</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="history-table-body">
                        <tr><td colspan="6" class="empty-state">Carregando histórico...</td></tr>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>

<!-- NOVO AGENDAMENTO -->
<div class="modal-overlay" id="modal-agendamento">
    <div class="modal-card">
        <div class="modal-header">
            <h3 class="modal-title">Novo agendamento</h3>
            <button type="button" class="btn-close" data-close="modal-agendamento"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <form id="form-agendamento">
            <div class="form-grid">
                <div class="form-group full">
                    <label class="form-label">Paciente cadastrado</label>
                    <select class="form-control" id="schedule-client" required></select>
                </div>

                <div class="form-group">
                    <label class="form-label">Profissional cadastrado</label>
                    <select class="form-control" id="schedule-doctor" required></select>
                </div>

                <div class="form-group">
                    <label class="form-label">Sala</label>
                    <select class="form-control" id="schedule-room" required>
                        <option value="CS01">CS01</option><option value="CS02">CS02</option>
                        <option value="CS03">CS03</option><option value="CS04">CS04</option>
                        <option value="CS05">CS05</option><option value="CS06">CS06</option>
                        <option value="CS07">CS07</option><option value="CS08">CS08</option>
                        <option value="CS09">CS09</option><option value="CS10">CS10</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Data</label>
                    <input type="date" class="form-control" id="schedule-date" required>
                </div>

                <div class="form-group">
                    <label class="form-label">Horário</label>
                    <input type="time" class="form-control" id="schedule-time" required>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-secondary" data-close="modal-agendamento">Cancelar</button>
                <button type="submit" class="btn-primary">Salvar agendamento</button>
            </div>
        </form>
    </div>
</div>

<!-- NOVO PACIENTE -->
<div class="modal-overlay" id="modal-paciente">
    <div class="modal-card">
        <div class="modal-header">
            <h3 class="modal-title">Novo paciente</h3>
            <button type="button" class="btn-close" data-close="modal-paciente"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <form id="form-paciente">
            <div class="form-grid">
                <div class="form-group full">
                    <label class="form-label">Nome completo</label>
                    <input type="text" class="form-control" id="client-name" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Idade</label>
                    <input type="number" class="form-control" id="client-age" min="0" max="130" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Gênero</label>
                    <select class="form-control" id="client-gender" required>
                        <option value="MALE">Masculino</option>
                        <option value="FEMALE">Feminino</option>
                        <option value="OTHERS">Outro</option>
                    </select>
                </div>
                <div class="form-group full">
                    <label class="form-label">E-mail</label>
                    <input type="email" class="form-control" id="client-email">
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-secondary" data-close="modal-paciente">Cancelar</button>
                <button type="submit" class="btn-primary">Salvar paciente</button>
            </div>
        </form>
    </div>
</div>

<!-- NOVO PROFISSIONAL -->
<div class="modal-overlay" id="modal-profissional">
    <div class="modal-card">
        <div class="modal-header">
            <h3 class="modal-title">Novo profissional</h3>
            <button type="button" class="btn-close" data-close="modal-profissional"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <form id="form-profissional">
            <div class="form-grid">
                <div class="form-group full">
                    <label class="form-label">Nome completo</label>
                    <input type="text" class="form-control" id="doctor-name" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Idade</label>
                    <input type="number" class="form-control" id="doctor-age" min="18" max="130" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Gênero</label>
                    <select class="form-control" id="doctor-gender" required>
                        <option value="MALE">Masculino</option>
                        <option value="FEMALE">Feminino</option>
                        <option value="OTHERS">Outro</option>
                    </select>
                </div>
                <div class="form-group full">
                    <label class="form-label">E-mail</label>
                    <input type="email" class="form-control" id="doctor-email" required>
                </div>
                <div class="form-group full">
                    <label class="form-label">Especialidade</label>
                    <select class="form-control" id="doctor-specialty" required>
                        <option value="FISIOTERAPIA">Fisioterapia</option>
                        <option value="ODONTOLOGIA">Odontologia</option>
                        <option value="PSICOLOGIA">Psicologia</option>
                        <option value="CARDIOLOGIA">Cardiologia</option>
                        <option value="PEDIATRIA">Pediatria</option>
                        <option value="ORTOPEDIA">Ortopedia</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-secondary" data-close="modal-profissional">Cancelar</button>
                <button type="submit" class="btn-primary">Salvar profissional</button>
            </div>
        </form>
    </div>
</div>

<div class="toast" id="toast-notif" role="status" aria-live="polite">
    <i class="fa-solid fa-circle-check"></i>
    <span id="toast-message"></span>
</div>

<script>
(() => {
    'use strict';

    const API = {
        clients: '/API/Client',
        doctors: '/API/Doctor',
        schedules: '/API/Schedules'
    };

    const state = {
        clients: [],
        doctors: [],
        schedules: [],
        history: [],
        activeTab: 'dashboard'
    };

    const $ = (selector) => document.querySelector(selector);
    const $$ = (selector) => [...document.querySelectorAll(selector)];

    function idOf(value) {
        return value?.ID ?? value?.id;
    }

    function nameOf(value) {
        return value?.Name ?? value?.name ?? 'Sem nome';
    }

    function statusOf(value) {
        return value?.ScheduleStatus ?? value?.scheduleStatus ?? value?.Status ?? value?.status;
    }

    function clientIdOf(value) {
        return value?.ClientID ?? value?.clientID;
    }

    function doctorIdOf(value) {
        return value?.DocID ?? value?.docID;
    }

    function dateOf(value) {
        return value?.ScheduleDate ?? value?.scheduleDate;
    }

    function specialtyOf(doctor) {
        return String(doctor?.docPrf ?? doctor?.DocPrf ?? '').replaceAll('_', ' ');
    }

    function prettyStatus(status) {
        const value = String(status ?? '').toUpperCase();
        return {
            PENDENTE: 'Pendente',
            ATENDENDO: 'Em atendimento',
            ATENDIDO: 'Concluído',
            CANCELADO: 'Cancelado'
        }[value] ?? value;
    }

    function statusClass(status) {
        const value = String(status ?? '').toUpperCase();
        if (value === 'ATENDIDO') return 'concluido';
        if (value === 'ATENDENDO') return 'em-atendimento';
        if (value === 'CANCELADO') return 'cancelado';
        return 'aguardando';
    }

    function initials(name) {
        return String(name || '?')
            .trim()
            .split(/\s+/)
            .slice(0, 2)
            .map(x => x[0])
            .join('')
            .toUpperCase();
    }

    function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, char => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[char]));
    }

    function formatDateTime(value) {
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return '-';
        return date.toLocaleString('pt-BR', {
            dateStyle: 'short',
            timeStyle: 'short'
        });
    }

    async function request(url, options = {}) {
        const response = await fetch(url, {
            ...options,
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                ...(options.body ? { 'Content-Type': 'application/json' } : {}),
                ...(options.headers || {})
            }
        });

        const contentType = response.headers.get('content-type') || '';
        const data = contentType.includes('application/json')
            ? await response.json()
            : await response.text();

        if (!response.ok) {
            const message = typeof data === 'string'
                ? data
                : data?.message ?? data?.title ?? 'Erro na API.';
            throw new Error(`${response.status}: ${message}`);
        }

        return data;
    }

    function toast(message, error = false) {
        const element = $('#toast-notif');
        if (!element) return;
        $('#toast-message').textContent = message;
        element.classList.toggle('error', error);
        element.classList.add('show');
        window.setTimeout(() => element.classList.remove('show'), 3500);
    }

    function findClient(id) {
        return state.clients.find(x => String(idOf(x)) === String(id));
    }

    function findDoctor(id) {
        return state.doctors.find(x => String(idOf(x)) === String(id));
    }

    async function loadClients() {
        const result = await request(API.clients);
        state.clients = (Array.isArray(result) ? result : []).filter(x => {
            const status = String(x?.regStatus ?? x?.RegStatus ?? 'ATIVO').toUpperCase();
            return status === 'ATIVO' || status === '0';
        });
        renderClients();
        renderClientSelect();
        updateCounters();
    }

    async function loadDoctors() {
        const result = await request(API.doctors);
        state.doctors = (Array.isArray(result) ? result : []).filter(x => {
            const status = String(x?.regStatus ?? x?.RegStatus ?? 'ATIVO').toUpperCase();
            return status === 'ATIVO' || status === '0';
        });
        renderDoctors();
        renderDoctorSelect();
        updateCounters();
    }

    async function loadSchedules() {
        const result = await request(API.schedules);
        state.schedules = Array.isArray(result) ? result : [];
        renderAgenda();
        renderDashboard();
        renderHistory();
        updateCounters();
    }

    async function createClient(payload) {
        await request(API.clients, {
            method: 'POST',
            body: JSON.stringify(payload)
        });
        await loadClients();
        toast('Paciente cadastrado com sucesso.');
    }

    async function createDoctor(payload) {
        await request(API.doctors, {
            method: 'POST',
            body: JSON.stringify(payload)
        });
        await loadDoctors();
        toast('Profissional cadastrado com sucesso.');
    }

    async function createSchedule(payload) {
        await request(API.schedules, {
            method: 'POST',
            body: JSON.stringify(payload)
        });
        await loadSchedules();
        toast('Agendamento criado com sucesso.');
    }

    async function deleteClient(client) {
        const id = idOf(client);
        if (!confirm(`Deseja inativar ${nameOf(client)}?`)) return;

        await request(`${API.clients}/${encodeURIComponent(id)}/DeleteClient`, {
            method: 'POST',
            body: JSON.stringify(client)
        });

        await loadClients();
        toast('Paciente atualizado.');
    }

    async function deleteDoctor(doctor) {
        const id = idOf(doctor);
        if (!confirm(`Deseja inativar ${nameOf(doctor)}?`)) return;

        await request(`${API.doctors}/${encodeURIComponent(id)}/DeleteDoctor`, {
            method: 'POST',
            body: JSON.stringify(doctor)
        });

        await loadDoctors();
        toast('Profissional atualizado.');
    }

    async function finishSchedule(id) {
        await request(`${API.schedules}/${encodeURIComponent(id)}/Finish`, { method: 'PUT' });
        await loadSchedules();
        toast('Agendamento concluído.');
    }

    async function revertSchedule(id, status = 'PENDENTE') {
        await request(`${API.schedules}/${encodeURIComponent(id)}/Revert?status=${encodeURIComponent(status)}`, {
            method: 'PUT'
        });
        await loadSchedules();
        toast('Status do agendamento atualizado.');
    }

    function renderDashboard() {
        const upcoming = [...state.schedules]
            .filter(x => String(statusOf(x)).toUpperCase() !== 'CANCELADO')
            .sort((a, b) => new Date(dateOf(a)) - new Date(dateOf(b)))
            .slice(0, 5);

        const list = $('#dashboard-preview-list');
        if (!upcoming.length) {
            list.innerHTML = '<div class="empty-state">Nenhum agendamento encontrado.</div>';
        } else {
            list.innerHTML = upcoming.map(schedule => {
                const client = findClient(clientIdOf(schedule));
                const doctor = findDoctor(doctorIdOf(schedule));
                return `
                    <div class="appointment-preview-item">
                        <div class="preview-left">
                            <span class="preview-time">${new Date(dateOf(schedule)).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })}</span>
                            <div class="preview-info">
                                <strong>${escapeHtml(nameOf(client))}</strong>
                                <span>${escapeHtml(nameOf(doctor))}</span>
                            </div>
                        </div>
                        <span class="status-badge ${statusClass(statusOf(schedule))}">
                            ${escapeHtml(prettyStatus(statusOf(schedule)))}
                        </span>
                    </div>`;
            }).join('');
        }

        const total = state.schedules.length;
        const pending = state.schedules.filter(x => String(statusOf(x)).toUpperCase() === 'PENDENTE').length;
        const attended = state.schedules.filter(x => String(statusOf(x)).toUpperCase() === 'ATENDIDO').length;

        $('#dash-status-total').textContent = total;
        $('#dash-status-summary').textContent =
            `${pending} pendente(s), ${attended} concluído(s) e ${state.schedules.filter(x => String(statusOf(x)).toUpperCase() === 'CANCELADO').length} cancelado(s).`;
    }

    function renderAgenda() {
        const search = ($('#agenda-search')?.value || '').toLowerCase();
        const statusFilter = $('#agenda-status')?.value || '';

        const rows = [...state.schedules]
            .sort((a, b) => new Date(dateOf(a)) - new Date(dateOf(b)))
            .filter(schedule => {
                const client = findClient(clientIdOf(schedule));
                const doctor = findDoctor(doctorIdOf(schedule));
                const text = `${nameOf(client)} ${nameOf(doctor)}`.toLowerCase();
                const status = String(statusOf(schedule)).toUpperCase();
                return (!search || text.includes(search)) &&
                       (!statusFilter || status === statusFilter);
            });

        const list = $('#appointment-list');

        if (!rows.length) {
            list.innerHTML = '<div class="empty-state">Nenhum agendamento encontrado.</div>';
            return;
        }

        list.innerHTML = rows.map(schedule => {
            const id = idOf(schedule);
            const client = findClient(clientIdOf(schedule));
            const doctor = findDoctor(doctorIdOf(schedule));
            const status = String(statusOf(schedule)).toUpperCase();
            const css = statusClass(status);

            let actions = '';
            if (status === 'PENDENTE') {
                actions = `
                    <button type="button" class="btn-action btn-start" data-schedule-action="start" data-id="${id}">
                        <i class="fa-solid fa-play"></i> Iniciar
                    </button>
                    <button type="button" class="btn-action btn-cancel" data-schedule-action="cancel" data-id="${id}">
                        <i class="fa-solid fa-xmark"></i>
                    </button>`;
            } else if (status === 'ATENDENDO') {
                actions = `
                    <button type="button" class="btn-action btn-complete" data-schedule-action="finish" data-id="${id}">
                        <i class="fa-solid fa-check"></i> Concluir
                    </button>`;
            } else if (status === 'ATENDIDO' || status === 'CANCELADO') {
                actions = `
                    <button type="button" class="btn-action btn-revert" data-schedule-action="revert" data-id="${id}">
                        <i class="fa-solid fa-rotate-left"></i> Reverter
                    </button>`;
            }

            return `
                <div class="timeline-slot">
                    <div class="time-label">
                        ${new Date(dateOf(schedule)).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })}
                    </div>
                    <div class="appointment-card status-${css}">
                        <div class="patient-details">
                            <div class="patient-avatar">${initials(nameOf(client))}</div>
                            <div class="patient-info">
                                <div class="name">${escapeHtml(nameOf(client))}</div>
                                <div class="meta">
                                    <span>${escapeHtml(nameOf(doctor))}</span>
                                    <span class="meta-dot"></span>
                                    <span>${escapeHtml(specialtyOf(doctor))}</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-right-side">
                            <span class="status-badge ${css}">${escapeHtml(prettyStatus(status))}</span>
                            <div class="action-btns">${actions}</div>
                        </div>
                    </div>
                </div>`;
        }).join('');
    }

    function renderClients() {
        const search = ($('#patient-search')?.value || '').toLowerCase();
        const rows = state.clients.filter(client => {
            const text = `${nameOf(client)} ${client.Email ?? client.email ?? ''}`.toLowerCase();
            return text.includes(search);
        });

        const body = $('#patient-table-body');
        if (!rows.length) {
            body.innerHTML = '<tr><td colspan="6" class="empty-state">Nenhum paciente encontrado.</td></tr>';
            return;
        }

        body.innerHTML = rows.map(client => {
            const id = idOf(client);
            const gender = String(client.gender ?? client.Gender ?? 'OTHERS');
            return `
                <tr>
                    <td>
                        <div class="patient-cell">
                            <div class="patient-avatar">${initials(nameOf(client))}</div>
                            <div class="patient-info">
                                <div class="name">${escapeHtml(nameOf(client))}</div>
                                <div class="sub">ID: ${escapeHtml(id)}</div>
                            </div>
                        </div>
                    </td>
                    <td>${escapeHtml(client.Email ?? client.email ?? '-')}</td>
                    <td>${client.Age ?? client.age ?? '-'}</td>
                    <td>${gender === 'MALE' ? 'Masculino' : gender === 'FEMALE' ? 'Feminino' : 'Outro'}</td>
                    <td><span class="status-badge ativo">Ativo</span></td>
                    <td class="actions-cell">
                        <button type="button" class="btn-table-action danger-hover" data-client-delete="${id}" title="Inativar">
                            <i class="fa-solid fa-user-minus"></i>
                        </button>
                    </td>
                </tr>`;
        }).join('');
    }

    function renderDoctors() {
        const search = ($('#doctor-search')?.value || '').toLowerCase();
        const rows = state.doctors.filter(doctor => {
            const text = `${nameOf(doctor)} ${doctor.Email ?? doctor.email ?? ''} ${specialtyOf(doctor)}`.toLowerCase();
            return text.includes(search);
        });

        const grid = $('#doctors-grid-container');
        if (!rows.length) {
            grid.innerHTML = '<div class="empty-state">Nenhum profissional encontrado.</div>';
            return;
        }

        grid.innerHTML = rows.map(doctor => {
            const id = idOf(doctor);
            return `
                <div class="doctor-card">
                    <div class="doc-header-row">
                        <div class="doc-avatar-box">${initials(nameOf(doctor))}</div>
                        <div class="doc-main-info">
                            <h3>${escapeHtml(nameOf(doctor))}</h3>
                            <div class="registration">ID: ${escapeHtml(id)}</div>
                            <span class="specialty-badge">
                                <i class="fa-solid fa-stethoscope"></i>
                                ${escapeHtml(specialtyOf(doctor))}
                            </span>
                        </div>
                    </div>

                    <div class="doc-details-list">
                        <div class="doc-detail-item"><span>Idade:</span><strong>${doctor.Age ?? doctor.age ?? '-'}</strong></div>
                        <div class="doc-detail-item"><span>E-mail:</span><strong>${escapeHtml(doctor.Email ?? doctor.email ?? '-')}</strong></div>
                        <div class="doc-detail-item"><span>Status:</span><span class="status-badge ativo">Ativo</span></div>
                    </div>

                    <div class="card-actions">
                        <button type="button" class="btn-card-icon danger" data-doctor-delete="${id}" title="Inativar">
                            <i class="fa-solid fa-user-slash"></i>
                        </button>
                    </div>
                </div>`;
        }).join('');
    }

    function renderHistory() {
        const completed = state.schedules.filter(x => ['ATENDIDO', 'CANCELADO'].includes(String(statusOf(x)).toUpperCase()));
        const search = ($('#history-search')?.value || '').toLowerCase();

        const rows = completed.filter(schedule => {
            const client = findClient(clientIdOf(schedule));
            const doctor = findDoctor(doctorIdOf(schedule));
            return `${nameOf(client)} ${nameOf(doctor)}`.toLowerCase().includes(search);
        });

        state.history = completed;

        const body = $('#history-table-body');
        if (!rows.length) {
            body.innerHTML = '<tr><td colspan="6" class="empty-state">Nenhum registro histórico encontrado.</td></tr>';
            return;
        }

        body.innerHTML = rows.map(schedule => {
            const client = findClient(clientIdOf(schedule));
            const doctor = findDoctor(doctorIdOf(schedule));
            const status = String(statusOf(schedule)).toUpperCase();
            const css = statusClass(status);
            return `
                <tr>
                    <td>${formatDateTime(dateOf(schedule))}</td>
                    <td><div class="patient-cell"><div class="patient-avatar">${initials(nameOf(client))}</div><strong>${escapeHtml(nameOf(client))}</strong></div></td>
                    <td>${escapeHtml(nameOf(doctor))}</td>
                    <td>${escapeHtml(specialtyOf(doctor))}</td>
                    <td><span class="status-badge ${css}">${escapeHtml(prettyStatus(status))}</span></td>
                    <td>
                        <button type="button" class="btn-table-action" data-history-revert="${idOf(schedule)}">
                            <i class="fa-solid fa-rotate-left"></i> Reverter
                        </button>
                    </td>
                </tr>`;
        }).join('');

        $('#history-total').textContent = state.schedules.filter(x => String(statusOf(x)).toUpperCase() === 'ATENDIDO').length;
        $('#history-cancelled').textContent = state.schedules.filter(x => String(statusOf(x)).toUpperCase() === 'CANCELADO').length;
    }

    function renderClientSelect() {
        const select = $('#schedule-client');
        select.innerHTML = '<option value="">Selecione o paciente...</option>' +
            state.clients.map(client =>
                `<option value="${idOf(client)}">${escapeHtml(nameOf(client))}</option>`
            ).join('');
    }

    function renderDoctorSelect() {
        const select = $('#schedule-doctor');
        select.innerHTML = '<option value="">Selecione o profissional...</option>' +
            state.doctors.map(doctor =>
                `<option value="${idOf(doctor)}">${escapeHtml(nameOf(doctor))} — ${escapeHtml(specialtyOf(doctor))}</option>`
            ).join('');
    }

    function updateCounters() {
        const pending = state.schedules.filter(x => String(statusOf(x)).toUpperCase() === 'PENDENTE').length;
        const ongoing = state.schedules.filter(x => String(statusOf(x)).toUpperCase() === 'ATENDENDO').length;
        const attended = state.schedules.filter(x => String(statusOf(x)).toUpperCase() === 'ATENDIDO').length;

        $('#dash-total-schedules').textContent = state.schedules.length;
        $('#dash-total-clients').textContent = state.clients.length;
        $('#dash-total-doctors').textContent = state.doctors.length;
        $('#dash-total-attended').textContent = attended;

        $('#agenda-total').textContent = state.schedules.length;
        $('#agenda-pending').textContent = pending;
        $('#agenda-ongoing').textContent = ongoing;
        $('#agenda-attended').textContent = attended;

        $('#patients-total').textContent = state.clients.length;
        $('#doctors-total').textContent = state.doctors.length;
    }

    function switchTab(tab) {
        state.activeTab = tab;

        $$('.nav-item').forEach(item => item.classList.toggle('active', item.dataset.tab === tab));
        $$('.tab-pane').forEach(pane => pane.classList.toggle('active', pane.id === `tab-${tab}`));

        const titles = {
            dashboard: ['VISÃO GERAL', 'Clínica Vitta'],
            agenda: ['AGENDA', 'Agendamentos'],
            pacientes: ['PACIENTES', 'Pacientes cadastrados'],
            profissionais: ['PROFISSIONAIS', 'Corpo clínico'],
            historico: ['HISTÓRICO', 'Atendimentos']
        };

        $('#header-category-tag').textContent = titles[tab][0];
        $('#header-main-title').textContent = titles[tab][1];
    }

    function openModal(id) {
        const modal = $(`#${id}`);
        if (modal) modal.classList.add('active');
    }

    function closeModal(id) {
        const modal = $(`#${id}`);
        if (modal) modal.classList.remove('active');
    }

    async function initialize() {
        const today = new Date();
        $('#agenda-date').value = today.toISOString().slice(0, 10);
        $('#schedule-date').value = today.toISOString().slice(0, 10);

        try {
            await Promise.all([loadClients(), loadDoctors(), loadSchedules()]);
        } catch (error) {
            console.error(error);
            toast(`Não foi possível carregar os dados: ${error.message}`, true);
        }
    }

    document.addEventListener('click', async event => {
        const tab = event.target.closest('[data-action="tab"]');
        if (tab) {
            switchTab(tab.dataset.tabTarget);
            return;
        }

        const close = event.target.closest('[data-close]');
        if (close) {
            closeModal(close.dataset.close);
            return;
        }

        const action = event.target.closest('[data-action]');
        if (action?.dataset.action === 'new-appointment') openModal('modal-agendamento');
        if (action?.dataset.action === 'new-patient') openModal('modal-paciente');
        if (action?.dataset.action === 'new-doctor') openModal('modal-profissional');

        const clientDelete = event.target.closest('[data-client-delete]');
        if (clientDelete) {
            const client = findClient(clientDelete.dataset.clientDelete);
            if (client) {
                try { await deleteClient(client); } catch (e) { toast(e.message, true); }
            }
        }

        const doctorDelete = event.target.closest('[data-doctor-delete]');
        if (doctorDelete) {
            const doctor = findDoctor(doctorDelete.dataset.doctorDelete);
            if (doctor) {
                try { await deleteDoctor(doctor); } catch (e) { toast(e.message, true); }
            }
        }

        const scheduleAction = event.target.closest('[data-schedule-action]');
        if (scheduleAction) {
            try {
                const id = scheduleAction.dataset.id;
                const type = scheduleAction.dataset.scheduleAction;

                if (type === 'start') await revertSchedule(id, 'ATENDENDO');
                if (type === 'cancel') {
                    if (confirm('Cancelar este agendamento?')) await revertSchedule(id, 'CANCELADO');
                }
                if (type === 'finish') await finishSchedule(id);
                if (type === 'revert') await revertSchedule(id, 'PENDENTE');
            } catch (e) {
                toast(e.message, true);
            }
        }

        const historyRevert = event.target.closest('[data-history-revert]');
        if (historyRevert) {
            try {
                await revertSchedule(historyRevert.dataset.historyRevert, 'PENDENTE');
            } catch (e) {
                toast(e.message, true);
            }
        }
    });

    $('#agenda-search').addEventListener('input', renderAgenda);
    $('#agenda-status').addEventListener('change', renderAgenda);
    $('#patient-search').addEventListener('input', renderClients);
    $('#doctor-search').addEventListener('input', renderDoctors);
    $('#history-search').addEventListener('input', renderHistory);

    $('#form-paciente').addEventListener('submit', async event => {
        event.preventDefault();
        try {
            await createClient({
                Name: $('#client-name').value.trim(),
                Age: Number($('#client-age').value),
                gender: $('#client-gender').value,
                Email: $('#client-email').value.trim()
            });
            event.target.reset();
            closeModal('modal-paciente');
        } catch (e) {
            toast(e.message, true);
        }
    });

    $('#form-profissional').addEventListener('submit', async event => {
        event.preventDefault();
        try {
            await createDoctor({
                Name: $('#doctor-name').value.trim(),
                Age: Number($('#doctor-age').value),
                gender: $('#doctor-gender').value,
                Email: $('#doctor-email').value.trim(),
                docPrf: $('#doctor-specialty').value
            });
            event.target.reset();
            closeModal('modal-profissional');
        } catch (e) {
            toast(e.message, true);
        }
    });

    $('#form-agendamento').addEventListener('submit', async event => {
        event.preventDefault();

        try {
            const date = $('#schedule-date').value;
            const time = $('#schedule-time').value;

            await createSchedule({
                ClientID: $('#schedule-client').value,
                DocID: $('#schedule-doctor').value,
                consultingRooms: $('#schedule-room').value,
                ScheduleDate: `${date}T${time}:00`
            });

            event.target.reset();
            $('#schedule-date').value = new Date().toISOString().slice(0, 10);
            closeModal('modal-agendamento');
        } catch (e) {
            toast(e.message, true);
        }
    });

    $$('.modal-overlay').forEach(modal => {
        modal.addEventListener('click', event => {
            if (event.target === modal) modal.classList.remove('active');
        });
    });

    initialize();
})();
</script>
