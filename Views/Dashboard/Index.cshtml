@{
    ViewData["Title"] = "Gestão Integrada";
    Layout = "_DashboardLayout";
}

<div class="dashboard-shell">
    <!-- Unified Sidebar Navigation -->
    <aside class="sidebar" aria-label="Navegação Principal">
        <div class="brand-header">
            <div class="brand-logo-icon">
                <i class="fa-solid fa-heart-pulse"></i>
            </div>
            <div class="brand-text">
                <h1>Clínica Vitta</h1>
                <p>Cuidar é nossa missão</p>
            </div>
        </div>

        <ul class="nav-menu" role="tablist">
            <li class="nav-item active" data-tab="dashboard">
                <button type="button" onclick="switchTab('dashboard')" role="tab" aria-selected="true">
                    <i class="fa-solid fa-border-all"></i>
                    <span>Dashboard</span>
                </button>
            </li>
            <li class="nav-item" data-tab="agenda">
                <button type="button" onclick="switchTab('agenda')" role="tab" aria-selected="false">
                    <i class="fa-solid fa-calendar-days"></i>
                    <span>Agenda</span>
                </button>
            </li>
            <li class="nav-item" data-tab="pacientes">
                <button type="button" onclick="switchTab('pacientes')" role="tab" aria-selected="false">
                    <i class="fa-solid fa-user-group"></i>
                    <span>Pacientes</span>
                </button>
            </li>
            <li class="nav-item" data-tab="profissionais">
                <button type="button" onclick="switchTab('profissionais')" role="tab" aria-selected="false">
                    <i class="fa-solid fa-user-doctor"></i>
                    <span>Profissionais</span>
                </button>
            </li>
            <li class="nav-item" data-tab="historico">
                <button type="button" onclick="switchTab('historico')" role="tab" aria-selected="false">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    <span>Histórico</span>
                </button>
            </li>
        </ul>
    </aside>

    <!-- Main Wrapper Area -->
    <div class="main-wrapper">
        <!-- Unified Dynamic Top Header -->
        <header class="top-header">
            <div class="user-welcome">
                <span class="category-tag" id="header-category-tag">VISÃO GERAL</span>
                <h2 class="header-title" id="header-main-title">Olá, equipe Clínica Vitta</h2>
            </div>

            <div class="header-actions">
                <div id="dynamic-header-actions" class="header-actions"></div>

                <form class="logout-form" asp-controller="Auth" asp-action="Logout" method="post">
                    <button class="logout-button" type="submit" title="Encerrar Sessão">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Sair</span>
                    </button>
                </form>
            </div>
        </header>

        <!-- ============================================================
             TAB 1: DASHBOARD (VISÃO GERAL)
             ============================================================ -->
        <main class="content-body tab-pane active" id="tab-dashboard">
            <!-- Welcome Banner -->
            <section class="welcome-card">
                <div>
                    <span class="welcome-chip"><i class="fa-solid fa-sparkles"></i> Resumo de hoje</span>
                    <h2>Uma rotina organizada para cuidar melhor.</h2>
                    <p>Acompanhe os principais compromissos, pacientes e atendimentos da Clínica Vitta em um só lugar.</p>
                </div>
                <div class="welcome-illustration" aria-hidden="true">
                    <i class="fa-solid fa-shield-heart"></i>
                </div>
            </section>

            <!-- Metric Summary Cards -->
            <div class="stats-banner">
                <div class="stat-card">
                    <div class="stat-icon teal">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Consultas hoje</span>
                        <div class="stat-value" id="stat-dash-today">18</div>
                        <span class="stat-sub" id="stat-dash-today-sub">3 aguardando confirmação</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon blue">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Pacientes cadastrados</span>
                        <div class="stat-value" id="stat-dash-patients">156</div>
                        <span class="stat-sub" id="stat-dash-patients-sub">+8 nesta semana</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon purple">
                        <i class="fa-solid fa-user-doctor"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Profissionais ativos</span>
                        <div class="stat-value" id="stat-dash-doctors">12</div>
                        <span class="stat-sub" id="stat-dash-doctors-sub">Corpo clínico disponível</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon green">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Atendimentos concluídos</span>
                        <div class="stat-value" id="stat-dash-completed">6</div>
                        <span class="stat-sub" id="stat-dash-completed-sub">33% da agenda do dia</span>
                    </div>
                </div>
            </div>

            <!-- Lower Grid -->
            <div class="dashboard-lower-grid">
                <!-- Next Appointments Preview -->
                <article class="dashboard-card">
                    <div class="card-heading">
                        <div>
                            <span class="card-kicker">AGENDA DO DIA</span>
                            <h2>Próximos agendamentos</h2>
                        </div>
                        <a href="javascript:void(0)" onclick="switchTab('agenda')" class="visual-link">
                            Ver agenda completa <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>

                    <ul class="appointment-preview-list" id="dashboard-preview-list">
                        <li class="appointment-preview-item">
                            <div class="preview-left">
                                <span class="preview-time">08:00</span>
                                <div class="preview-info">
                                    <strong>João Silva</strong>
                                    <span>Fisioterapia • Dra. Marina Souza</span>
                                </div>
                            </div>
                            <span class="status-badge confirmado"><i class="fa-solid fa-circle-check"></i> Confirmado</span>
                        </li>
                        <li class="appointment-preview-item">
                            <div class="preview-left">
                                <span class="preview-time">09:30</span>
                                <div class="preview-info">
                                    <strong>Ana Costa</strong>
                                    <span>Odontologia • Dr. Felipe Santos</span>
                                </div>
                            </div>
                            <span class="status-badge aguardando"><i class="fa-solid fa-clock"></i> Aguardando</span>
                        </li>
                        <li class="appointment-preview-item">
                            <div class="preview-left">
                                <span class="preview-time">10:00</span>
                                <div class="preview-info">
                                    <strong>Patrícia Branco</strong>
                                    <span>Psicologia • Dra. Beatriz Lima</span>
                                </div>
                            </div>
                            <span class="status-badge em-atendimento"><i class="fa-solid fa-spinner fa-spin"></i> Em Atendimento</span>
                        </li>
                        <li class="appointment-preview-item">
                            <div class="preview-left">
                                <span class="preview-time">11:30</span>
                                <div class="preview-info">
                                    <strong>André Martins</strong>
                                    <span>Fisioterapia • Dra. Marina Souza</span>
                                </div>
                            </div>
                            <span class="status-badge confirmado"><i class="fa-solid fa-circle-check"></i> Confirmado</span>
                        </li>
                    </ul>
                </article>

                <!-- Daily Focus & Info -->
                <aside class="dashboard-card focus-card">
                    <span class="panel-subtitle">ORGANIZAÇÃO</span>
                    <h3 class="panel-title">Foco do Dia</h3>

                    <div class="progress-box">
                        <div class="progress-ring">
                            <svg>
                                <circle class="bg" cx="30" cy="30" r="24"></circle>
                                <circle class="meter" id="dash-progress-meter" cx="30" cy="30" r="24" style="stroke-dashoffset: 64;"></circle>
                            </svg>
                            <span class="progress-text-center" id="dash-progress-text">33%</span>
                        </div>
                        <div class="progress-meta">
                            <div class="count" id="dash-progress-count">6 de 18</div>
                            <div class="desc" id="dash-progress-desc">atendimentos finalizados</div>
                        </div>
                    </div>

                    <div class="alert-info-box" id="dash-progress-alert">
                        <i class="fa-solid fa-circle-info"></i>
                        <span id="dash-progress-alert-text">Três consultas ainda aguardam confirmação dos pacientes.</span>
                    </div>
                </aside>
            </div>
        </main>

        <!-- ============================================================
             TAB 2: AGENDA DE CONSULTAS
             ============================================================ -->
        <main class="content-body tab-pane" id="tab-agenda">
            <!-- Stats Banner -->
            <div class="stats-banner">
                <div class="stat-card">
                    <div class="stat-icon teal">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Consultas hoje</span>
                        <div class="stat-value" id="stat-total-agenda">18</div>
                        <span class="stat-sub">3 aguardando confirmação</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon amber">
                        <i class="fa-solid fa-user-clock"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Aguardando</span>
                        <div class="stat-value" id="stat-waiting-agenda">3</div>
                        <span class="stat-sub">Na recepção / Pendente</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon blue">
                        <i class="fa-solid fa-stethoscope"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Em atendimento</span>
                        <div class="stat-value" id="stat-ongoing-agenda">1</div>
                        <span class="stat-sub">Salas de consulta</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon green">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Concluídos</span>
                        <div class="stat-value" id="stat-completed-agenda">6</div>
                        <span class="stat-sub" id="stat-completed-agenda-sub">33% da agenda do dia</span>
                    </div>
                </div>
            </div>

            <!-- Left Panel: Main Agenda Timeline Grid -->
            <div class="agenda-container">
                <!-- Controls Row -->
                <div class="controls-row">
                    <div class="date-navigator">
                        <button type="button" onclick="changeDate(-1)" title="Dia Anterior"><i class="fa-solid fa-chevron-left"></i></button>
                        <span class="current-date-text" id="date-display">24 de Agosto, 2026 (Hoje)</span>
                        <button type="button" onclick="changeDate(1)" title="Próximo Dia"><i class="fa-solid fa-chevron-right"></i></button>
                    </div>

                    <div class="filter-group">
                        <input type="text" class="search-input" placeholder="Buscar paciente..." id="search-agenda-input" onkeyup="filterAppointments()">

                        <select class="select-input" id="agenda-status-filter" onchange="filterAppointments()">
                            <option value="todos">Todos os Status</option>
                            <option value="confirmado">Confirmado</option>
                            <option value="aguardando">Aguardando</option>
                            <option value="em-atendimento">Em Atendimento</option>
                            <option value="concluido">Concluído</option>
                            <option value="cancelado">Cancelado</option>
                        </select>

                        <div class="view-toggler">
                            <button type="button" class="view-btn active" onclick="setAgendaView('dia', this)">Dia</button>
                            <button type="button" class="view-btn" onclick="setAgendaView('semana', this)">Semana</button>
                            <button type="button" class="view-btn" onclick="setAgendaView('mes', this)">Mês</button>
                        </div>
                    </div>
                </div>

                <!-- Timeline Appointments List -->
                <div class="timeline-list" id="appointment-list">
                    <!-- Slot 08:00 -->
                    <div class="timeline-slot" data-status="confirmado" data-doctor="Dra. Marina Souza" data-name="João Silva">
                        <div class="time-label">08:00</div>
                        <div class="appointment-card status-confirmed">
                            <div class="patient-details">
                                <div class="patient-avatar">JS</div>
                                <div class="patient-info">
                                    <div class="name">João Silva</div>
                                    <div class="meta">
                                        <span>Fisioterapia</span>
                                        <span class="meta-dot"></span>
                                        <span>Dra. Marina Souza</span>
                                        <span class="meta-dot"></span>
                                        <span>Primeira Consulta</span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-right-side">
                                <span class="status-badge confirmado">
                                    <i class="fa-solid fa-circle-check"></i> Confirmado
                                </span>
                                <div class="action-btns">
                                    <button type="button" class="btn-action btn-start" onclick="updateStatus(this, 'em-atendimento')">
                                        <i class="fa-solid fa-play"></i> Iniciar
                                    </button>
                                    <button type="button" class="btn-action btn-cancel" onclick="updateStatus(this, 'cancelado')">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Slot 09:30 -->
                    <div class="timeline-slot" data-status="aguardando" data-doctor="Dr. Felipe Santos" data-name="Ana Costa">
                        <div class="time-label">09:30</div>
                        <div class="appointment-card status-waiting">
                            <div class="patient-details">
                                <div class="patient-avatar" style="background-color: #fef3c7; color: #d97706;">AC</div>
                                <div class="patient-info">
                                    <div class="name">Ana Costa</div>
                                    <div class="meta">
                                        <span>Odontologia</span>
                                        <span class="meta-dot"></span>
                                        <span>Dr. Felipe Santos</span>
                                        <span class="meta-dot"></span>
                                        <span>Retorno</span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-right-side">
                                <span class="status-badge aguardando">
                                    <i class="fa-solid fa-clock"></i> Aguardando
                                </span>
                                <div class="action-btns">
                                    <button type="button" class="btn-action btn-start" onclick="updateStatus(this, 'em-atendimento')">
                                        <i class="fa-solid fa-play"></i> Iniciar
                                    </button>
                                    <button type="button" class="btn-action btn-cancel" onclick="updateStatus(this, 'cancelado')">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Slot 10:00 -->
                    <div class="timeline-slot" data-status="em-atendimento" data-doctor="Dra. Beatriz Lima" data-name="Patrícia Branco">
                        <div class="time-label">10:00</div>
                        <div class="appointment-card status-ongoing">
                            <div class="patient-details">
                                <div class="patient-avatar" style="background-color: #dbeafe; color: #2563eb;">PB</div>
                                <div class="patient-info">
                                    <div class="name">Patrícia Branco</div>
                                    <div class="meta">
                                        <span>Psicologia</span>
                                        <span class="meta-dot"></span>
                                        <span>Dra. Beatriz Lima</span>
                                        <span class="meta-dot"></span>
                                        <span>Sessão Semanal</span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-right-side">
                                <span class="status-badge em-atendimento">
                                    <i class="fa-solid fa-spinner fa-spin"></i> Em Atendimento
                                </span>
                                <div class="action-btns">
                                    <button type="button" class="btn-action btn-complete" onclick="updateStatus(this, 'concluido')">
                                        <i class="fa-solid fa-check"></i> Concluir
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Slot 11:30 -->
                    <div class="timeline-slot" data-status="confirmado" data-doctor="Dra. Marina Souza" data-name="André Martins">
                        <div class="time-label">11:30</div>
                        <div class="appointment-card status-confirmed">
                            <div class="patient-details">
                                <div class="patient-avatar">AM</div>
                                <div class="patient-info">
                                    <div class="name">André Martins</div>
                                    <div class="meta">
                                        <span>Fisioterapia</span>
                                        <span class="meta-dot"></span>
                                        <span>Dra. Marina Souza</span>
                                        <span class="meta-dot"></span>
                                        <span>Acompanhamento</span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-right-side">
                                <span class="status-badge confirmado">
                                    <i class="fa-solid fa-circle-check"></i> Confirmado
                                </span>
                                <div class="action-btns">
                                    <button type="button" class="btn-action btn-start" onclick="updateStatus(this, 'em-atendimento')">
                                        <i class="fa-solid fa-play"></i> Iniciar
                                    </button>
                                    <button type="button" class="btn-action btn-cancel" onclick="updateStatus(this, 'cancelado')">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Slot 14:00 -->
                    <div class="timeline-slot" data-status="concluido" data-doctor="Dr. Carlos Eduardo" data-name="Fernanda Lima">
                        <div class="time-label">14:00</div>
                        <div class="appointment-card status-completed">
                            <div class="patient-details">
                                <div class="patient-avatar" style="background-color: #f1f5f9; color: #475569;">FL</div>
                                <div class="patient-info">
                                    <div class="name">Fernanda Lima</div>
                                    <div class="meta">
                                        <span>Cardiologia</span>
                                        <span class="meta-dot"></span>
                                        <span>Dr. Carlos Eduardo</span>
                                        <span class="meta-dot"></span>
                                        <span>Check-up</span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-right-side">
                                <span class="status-badge concluido">
                                    <i class="fa-solid fa-check-double"></i> Concluído
                                </span>
                                <button type="button" class="btn-icon-only" title="Ver Detalhes" onclick="switchTab('historico')">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Panel: Organização & Médicos -->
            <div class="right-panel">
                <div class="focus-card">
                    <span class="panel-subtitle">ORGANIZAÇÃO</span>
                    <h3 class="panel-title">Foco do Dia</h3>

                    <div class="progress-box">
                        <div class="progress-ring">
                            <svg>
                                <circle class="bg" cx="30" cy="30" r="24"></circle>
                                <circle class="meter" cx="30" cy="30" r="24" style="stroke-dashoffset: 64;"></circle>
                            </svg>
                            <span class="progress-text-center">35%</span>
                        </div>
                        <div class="progress-meta">
                            <div class="count">6 de 18</div>
                            <div class="desc">atendimentos finalizados</div>
                        </div>
                    </div>

                    <div class="alert-info-box">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>Três consultas ainda aguardam confirmação do paciente.</span>
                    </div>
                </div>

                <!-- Doctor Filter Sidebar Widget -->
                <div class="focus-card">
                    <span class="panel-subtitle">FILTRAR POR MÉDICO</span>
                    <h3 class="panel-title">Profissionais Hoje</h3>

                    <div class="doctor-list">
                        <div class="doctor-item active" onclick="filterAgendaDoctor('todos', this)">
                            <div class="doc-profile">
                                <div class="doc-name">Todos os Médicos</div>
                            </div>
                            <span class="doc-count">18</span>
                        </div>

                        <div class="doctor-item" onclick="filterAgendaDoctor('Dra. Marina Souza', this)">
                            <div class="doc-profile">
                                <div class="doc-avatar" style="background-color: #008a83;">MS</div>
                                <div>
                                    <div class="doc-name">Dra. Marina Souza</div>
                                    <div class="doc-spec">Fisioterapia</div>
                                </div>
                            </div>
                            <span class="doc-count">6</span>
                        </div>

                        <div class="doctor-item" onclick="filterAgendaDoctor('Dr. Felipe Santos', this)">
                            <div class="doc-profile">
                                <div class="doc-avatar" style="background-color: #2563eb;">FS</div>
                                <div>
                                    <div class="doc-name">Dr. Felipe Santos</div>
                                    <div class="doc-spec">Odontologia</div>
                                </div>
                            </div>
                            <span class="doc-count">5</span>
                        </div>

                        <div class="doctor-item" onclick="filterAgendaDoctor('Dra. Beatriz Lima', this)">
                            <div class="doc-profile">
                                <div class="doc-avatar" style="background-color: #d97706;">BL</div>
                                <div>
                                    <div class="doc-name">Dra. Beatriz Lima</div>
                                    <div class="doc-spec">Psicologia</div>
                                </div>
                            </div>
                            <span class="doc-count">4</span>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- ============================================================
             TAB 3: GESTÃO DE PACIENTES
             ============================================================ -->
        <main class="content-body tab-pane" id="tab-pacientes">
            <!-- Stats Banner -->
            <div class="stats-banner">
                <div class="stat-card">
                    <div class="stat-icon teal">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Total Cadastrados</span>
                        <div class="stat-value" id="stat-total-patients">156</div>
                        <span class="stat-sub" id="stat-total-patients-sub">+8 cadastros esta semana</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon green">
                        <i class="fa-solid fa-user-check"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Pacientes Ativos</span>
                        <div class="stat-value" id="stat-active-patients">148</div>
                        <span class="stat-sub" id="stat-active-patients-sub">95% da base total</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon blue">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Atendidos no Mês</span>
                        <div class="stat-value" id="stat-attended-month-patients">42</div>
                        <span class="stat-sub" id="stat-attended-month-patients-sub">Consultas realizadas</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon amber">
                        <i class="fa-solid fa-user-slash"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Inativos / Pausados</span>
                        <div class="stat-value" id="stat-inactive-patients">8</div>
                        <span class="stat-sub" id="stat-inactive-patients-sub">Sem retorno > 6 meses</span>
                    </div>
                </div>
            </div>

            <!-- Table Container -->
            <div class="table-container">
                <!-- Filters Bar -->
                <div class="controls-row">
                    <div class="search-wrapper">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" class="search-input" id="search-patient" placeholder="Buscar por nome, CPF ou telefone..." onkeyup="filterPatients()">
                    </div>

                    <div class="filter-group">
                        <select class="select-input" id="filter-patient-plan" onchange="filterPatients()">
                            <option value="todos">Todos os Convênios</option>
                            <option value="Unimed">Unimed</option>
                            <option value="Particular">Particular</option>
                            <option value="Bradesco">Bradesco Saúde</option>
